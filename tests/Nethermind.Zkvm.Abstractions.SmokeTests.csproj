<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../src/Nethermind.Zkvm.Abstractions.csproj" AdditionalProperties="Zisk=true" />
  </ItemGroup>
  <Target Name="BuildNativeStub" BeforeTargets="CopyFilesToOutputDirectory">
    <MakeDir Directories="$(OutDir)" />
    <Exec Command="gcc -shared -fPIC &quot;$(MSBuildProjectDirectory)/bitmap-test.c&quot; -o &quot;$(OutDir)bitmap-test.dll&quot;" />
  </Target>
</Project>
